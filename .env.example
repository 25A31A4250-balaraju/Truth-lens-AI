# ─────────────────────────────────────────────────────────────────
# TruthLensAI — Environment Variables Reference
# Copy this file to .env for local development.
# For Railway/Render, set these directly in the dashboard.
# ─────────────────────────────────────────────────────────────────

# Sightengine AI-Generated Image Detection API Credentials
# Get your free API credentials from: https://sightengine.com/
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# CORS — comma-separated list of allowed frontend origins
# Add your Netlify site URL here (no trailing slash)
# Example: https://truthlensai.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://*.netlify.app

# Server (Railway sets PORT automatically — do not override)
# HOST=0.0.0.0
# PORT=8000

# Environment flag
ENVIRONMENT=production
